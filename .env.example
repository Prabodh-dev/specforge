# Environment Configuration

# ===========================================
# Core Application
# ===========================================
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173

# ===========================================
# Database
# ===========================================
DATABASE_URL=postgresql://user:password@localhost:5432/specforge

# ===========================================
# Authentication
# ===========================================
JWT_ACCESS_SECRET=your-access-secret-change-this-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-this-in-production
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ===========================================
# Redis (for job queues)
# ===========================================
REDIS_URL=redis://localhost:6379

# ===========================================
# AI/LLM Provider
# ===========================================
# Options: 'mock', 'gemini', 'openai', 'ollama'
LLM_PROVIDER=gemini

# Google Gemini (recommended)
GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI (optional)
OPENAI_API_KEY=your-openai-api-key-here

# Ollama (optional - for local LLM)
OLLAMA_BASE_URL=http://localhost:11434

# ===========================================
# Cloudflare R2 / S3-Compatible Storage
# ===========================================
# Required for export file storage
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-bucket-name

# Optional: Public URL base for R2 
# Leave empty to auto-generate from endpoint
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxx.r2.dev
